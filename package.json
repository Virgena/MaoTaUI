{
  "name": "maotaui",
  "version": "0.3.0",
  "description": "现代无头 Web Components 组件库, SSR 安全、零水合报错",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/index.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./icons": {
      "types": "./dist/core/icons.d.ts",
      "default": "./dist/core/icons.js"
    },
    "./registry": {
      "types": "./dist/core/registry.d.ts",
      "default": "./dist/core/registry.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "icons": "node --experimental-strip-types scripts/build-icons.ts",
    "predev": "pnpm icons",
    "dev": "pnpm --filter maotaui-website dev",
    "prebuild": "pnpm icons",
    "build": "pnpm --filter maotaui-website build",
    "pretypecheck": "pnpm icons",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "node --experimental-strip-types website/check-contrast.ts",
    "pressr": "pnpm icons",
    "ssr": "node --experimental-strip-types scripts/ssr-smoke.ts",
    "build:lib": "pnpm icons && tsc -p tsconfig.json --noEmit false --outDir dist --declaration --rewriteRelativeImportExtensions && node -e \"const fs=require('node:fs');fs.rmSync('dist/fonts',{recursive:true,force:true});fs.mkdirSync('dist/fonts',{recursive:true});fs.copyFileSync('src/styles.css','dist/styles.css');for(const file of fs.readdirSync('src/fonts'))fs.copyFileSync('src/fonts/'+file,'dist/fonts/'+file)\"",
    "prepublishOnly": "pnpm build:lib"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.152",
    "typescript": "^5.9.3"
  }
}
