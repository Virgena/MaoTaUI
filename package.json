{
  "name": "maotaui",
  "version": "0.2.0",
  "type": "module",
  "main": "src/index.ts",
  "module": "./dist/index.js",
  "types": "src/index.ts",
  "files": ["dist"],
  "sideEffects": [
    "**/*.css",
    "./src/index.ts",
    "./src/elements/*.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./icons": "./src/core/icons.ts",
    "./registry": "./src/core/registry.ts",
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "icons": "node --experimental-strip-types scripts/build-icons.ts",
    "predev": "pnpm icons",
    "dev": "pnpm --filter maotaui-website dev",
    "prebuild": "pnpm icons",
    "build": "pnpm --filter maotaui-website build",
    "pretypecheck": "pnpm icons",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "node --experimental-strip-types website/check-contrast.ts",
    "pressr": "pnpm icons",
    "ssr": "node --experimental-strip-types scripts/ssr-smoke.ts",
    "build:lib": "pnpm icons && tsc -p tsconfig.json --noEmit false --outDir dist --declaration --rewriteRelativeImportExtensions && node -e \"require('node:fs').copyFileSync('src/styles.css','dist/styles.css')\"",
    "prepublishOnly": "pnpm build:lib"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.152",
    "typescript": "^5.9.3"
  }
}
